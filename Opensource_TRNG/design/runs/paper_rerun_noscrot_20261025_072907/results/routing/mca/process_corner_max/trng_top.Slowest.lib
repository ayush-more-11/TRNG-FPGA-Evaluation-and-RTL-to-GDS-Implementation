library (trng_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }

  cell ("trng_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0235;
    }
    pin("dbg_raw_bit") {
      direction : output;
      capacitance : 0.0010;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.61198,1.62107,1.64611,1.71271,1.91336,2.62145,5.17518");
	}
	rise_transition(template_1) {
          values("0.03921,0.04588,0.06724,0.13820,0.40704,1.40373,4.99443");
	}
	cell_fall(template_1) {
          values("1.57015,1.57798,1.60017,1.65636,1.81198,2.34823,4.27493");
	}
	fall_transition(template_1) {
          values("0.03435,0.03976,0.05685,0.10956,0.30110,1.02074,3.64184");
	}
      }
    }
    pin("dbg_raw_valid") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.72222,1.73132,1.75635,1.82297,2.02363,2.73155,5.28543");
	}
	rise_transition(template_1) {
          values("0.03920,0.04587,0.06724,0.13822,0.40708,1.40300,4.99390");
	}
	cell_fall(template_1) {
          values("1.67831,1.68614,1.70832,1.76450,1.92018,2.45642,4.38296");
	}
	fall_transition(template_1) {
          values("0.03435,0.03976,0.05685,0.10957,0.30110,1.02075,3.64173");
	}
      }
    }
    pin("health_fail") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.24505,2.25556,2.28302,2.35563,2.58136,3.32275,5.77806");
	}
	rise_transition(template_1) {
          values("0.03309,0.04182,0.06858,0.15845,0.47299,1.52714,5.00492");
	}
	cell_fall(template_1) {
          values("2.44896,2.45889,2.48291,2.53666,2.67265,3.09428,4.48834");
	}
	fall_transition(template_1) {
          values("0.03268,0.03937,0.05713,0.10715,0.27056,0.84149,2.74617");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("1.29954");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.97483");
	}
      }
    }
    pin("tx") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.75408,1.76317,1.78829,1.85481,2.05546,2.76294,5.31712");
	}
	rise_transition(template_1) {
          values("0.03925,0.04587,0.06713,0.13828,0.40710,1.40230,4.99520");
	}
	cell_fall(template_1) {
          values("1.68217,1.68996,1.71221,1.76826,1.92462,2.46070,4.38548");
	}
	fall_transition(template_1) {
          values("0.03435,0.03975,0.05690,0.10970,0.30106,1.02083,3.64054");
	}
      }
    }
  }

}
