library (trng_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }

  cell ("trng_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0210;
    }
    pin("dbg_raw_bit") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.57437,1.57762,1.58623,1.60851,1.67419,1.88834,2.60188");
	}
	rise_transition(template_1) {
          values("0.01570,0.01819,0.02599,0.05209,0.14406,0.45843,1.50151");
	}
	cell_fall(template_1) {
          values("1.53249,1.53553,1.54358,1.56228,1.60777,1.74311,2.19052");
	}
	fall_transition(template_1) {
          values("0.01540,0.01756,0.02336,0.03902,0.08875,0.26663,0.86717");
	}
      }
    }
    pin("dbg_raw_valid") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.66934,1.67258,1.68120,1.70347,1.76915,1.98328,2.69662");
	}
	rise_transition(template_1) {
          values("0.01570,0.01818,0.02599,0.05209,0.14408,0.45844,1.50138");
	}
	cell_fall(template_1) {
          values("1.62587,1.62892,1.63696,1.65566,1.70115,1.83649,2.28381");
	}
	fall_transition(template_1) {
          values("0.01540,0.01756,0.02337,0.03903,0.08874,0.26666,0.86733");
	}
      }
    }
    pin("health_fail") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.16488,2.16913,2.17917,2.20438,2.27775,2.50387,3.19229");
	}
	rise_transition(template_1) {
          values("0.01553,0.01884,0.02833,0.06030,0.16604,0.49707,1.51020");
	}
	cell_fall(template_1) {
          values("2.38253,2.38588,2.39386,2.41071,2.44897,2.55377,2.87349");
	}
	fall_transition(template_1) {
          values("0.01274,0.01517,0.02087,0.03525,0.07666,0.21233,0.64329");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.43713");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.33142");
	}
      }
    }
    pin("tx") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.69795,1.70117,1.70984,1.73216,1.79775,2.01171,2.72209");
	}
	rise_transition(template_1) {
          values("0.01586,0.01829,0.02610,0.05217,0.14441,0.45861,1.49993");
	}
	cell_fall(template_1) {
          values("1.62950,1.63254,1.64056,1.65924,1.70478,1.84012,2.28703");
	}
	fall_transition(template_1) {
          values("0.01540,0.01757,0.02338,0.03906,0.08871,0.26663,0.86724");
	}
      }
    }
  }

}
