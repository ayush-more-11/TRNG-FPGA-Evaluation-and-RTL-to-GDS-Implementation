library (trng_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }

  cell ("trng_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0221;
    }
    pin("dbg_raw_bit") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.59085,1.59994,1.62498,1.69157,1.89223,2.60033,5.15404");
	}
	rise_transition(template_1) {
          values("0.03921,0.04588,0.06725,0.13820,0.40703,1.40378,4.99446");
	}
	cell_fall(template_1) {
          values("1.54914,1.55697,1.57916,1.63535,1.79096,2.32722,4.25393");
	}
	fall_transition(template_1) {
          values("0.03435,0.03976,0.05685,0.10956,0.30110,1.02074,3.64185");
	}
      }
    }
    pin("dbg_raw_valid") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.69303,1.70213,1.72716,1.79378,1.99444,2.70239,5.25624");
	}
	rise_transition(template_1) {
          values("0.03920,0.04587,0.06724,0.13821,0.40707,1.40315,4.99401");
	}
	cell_fall(template_1) {
          values("1.64951,1.65734,1.67952,1.73570,1.89137,2.42761,4.35419");
	}
	fall_transition(template_1) {
          values("0.03435,0.03976,0.05685,0.10957,0.30110,1.02075,3.64176");
	}
      }
    }
    pin("health_fail") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.20537,2.21582,2.24319,2.31575,2.54149,3.28291,5.73800");
	}
	rise_transition(template_1) {
          values("0.03283,0.04158,0.06838,0.15835,0.47301,1.52724,5.00474");
	}
	cell_fall(template_1) {
          values("2.41572,2.42565,2.44967,2.50341,2.63939,3.06100,4.45498");
	}
	fall_transition(template_1) {
          values("0.03268,0.03937,0.05712,0.10714,0.27055,0.84147,2.74605");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0033;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("1.27698");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.95478");
	}
      }
    }
    pin("tx") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.72464,1.73374,1.75885,1.82537,2.02603,2.73352,5.28769");
	}
	rise_transition(template_1) {
          values("0.03925,0.04587,0.06713,0.13828,0.40711,1.40223,4.99503");
	}
	cell_fall(template_1) {
          values("1.65428,1.66208,1.68433,1.74038,1.89674,2.43282,4.35744");
	}
	fall_transition(template_1) {
          values("0.03435,0.03975,0.05690,0.10970,0.30105,1.02082,3.64038");
	}
      }
    }
  }

}
