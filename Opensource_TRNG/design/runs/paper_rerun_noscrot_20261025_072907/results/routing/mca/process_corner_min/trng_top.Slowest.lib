library (trng_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }

  cell ("trng_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0209;
    }
    pin("dbg_raw_bit") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.57298,1.58207,1.60711,1.67369,1.87435,2.58246,5.13617");
	}
	rise_transition(template_1) {
          values("0.03921,0.04588,0.06725,0.13820,0.40703,1.40381,4.99449");
	}
	cell_fall(template_1) {
          values("1.53136,1.53919,1.56137,1.61756,1.77318,2.30943,4.23615");
	}
	fall_transition(template_1) {
          values("0.03435,0.03976,0.05685,0.10956,0.30110,1.02074,3.64186");
	}
      }
    }
    pin("dbg_raw_valid") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.66811,1.67721,1.70224,1.76885,1.96951,2.67749,5.23131");
	}
	rise_transition(template_1) {
          values("0.03920,0.04587,0.06724,0.13821,0.40707,1.40326,4.99409");
	}
	cell_fall(template_1) {
          values("1.62488,1.63271,1.65489,1.71108,1.86673,2.40298,4.32958");
	}
	fall_transition(template_1) {
          values("0.03435,0.03976,0.05685,0.10956,0.30110,1.02075,3.64177");
	}
      }
    }
    pin("health_fail") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.16451,2.17488,2.20213,2.27462,2.50036,3.24184,5.69660");
	}
	rise_transition(template_1) {
          values("0.03246,0.04124,0.06808,0.15821,0.47304,1.52740,5.00448");
	}
	cell_fall(template_1) {
          values("2.38212,2.39204,2.41607,2.46979,2.60577,3.02735,4.42122");
	}
	fall_transition(template_1) {
          values("0.03267,0.03937,0.05712,0.10713,0.27053,0.84145,2.74588");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0032;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("1.25966");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.94308");
	}
      }
    }
    pin("tx") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.69729,1.70639,1.73149,1.79804,1.99869,2.70618,5.26036");
	}
	rise_transition(template_1) {
          values("0.03924,0.04586,0.06714,0.13827,0.40711,1.40214,4.99481");
	}
	cell_fall(template_1) {
          values("1.62898,1.63679,1.65904,1.71510,1.87142,2.40751,4.33217");
	}
	fall_transition(template_1) {
          values("0.03435,0.03975,0.05690,0.10969,0.30106,1.02081,3.64038");
	}
      }
    }
  }

}
