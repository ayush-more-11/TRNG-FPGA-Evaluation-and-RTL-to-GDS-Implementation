library (trng_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }

  cell ("trng_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0221;
    }
    pin("dbg_raw_bit") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.59258,1.59582,1.60444,1.62671,1.69239,1.90654,2.62007");
	}
	rise_transition(template_1) {
          values("0.01570,0.01819,0.02599,0.05209,0.14406,0.45843,1.50150");
	}
	cell_fall(template_1) {
          values("1.55054,1.55359,1.56164,1.58034,1.62582,1.76116,2.20856");
	}
	fall_transition(template_1) {
          values("0.01540,0.01756,0.02336,0.03902,0.08875,0.26663,0.86718");
	}
      }
    }
    pin("dbg_raw_valid") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.69460,1.69784,1.70646,1.72873,1.79441,2.00854,2.72184");
	}
	rise_transition(template_1) {
          values("0.01570,0.01818,0.02599,0.05209,0.14409,0.45844,1.50135");
	}
	cell_fall(template_1) {
          values("1.65077,1.65382,1.66186,1.68056,1.72605,1.86139,2.30870");
	}
	fall_transition(template_1) {
          values("0.01540,0.01756,0.02337,0.03903,0.08874,0.26667,0.86736");
	}
      }
    }
    pin("health_fail") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.20596,2.21025,2.22035,2.24560,2.31897,2.54504,3.23352");
	}
	rise_transition(template_1) {
          values("0.01572,0.01904,0.02854,0.06040,0.16604,0.49700,1.51006");
	}
	cell_fall(template_1) {
          values("2.41636,2.41972,2.42770,2.44456,2.48281,2.58761,2.90737");
	}
	fall_transition(template_1) {
          values("0.01280,0.01522,0.02092,0.03527,0.07667,0.21232,0.64309");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.44488");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.33721");
	}
      }
    }
    pin("tx") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.72548,1.72871,1.73739,1.75971,1.82530,2.03932,2.74974");
	}
	rise_transition(template_1) {
          values("0.01592,0.01836,0.02615,0.05219,0.14441,0.45861,1.50020");
	}
	cell_fall(template_1) {
          values("1.65495,1.65799,1.66600,1.68468,1.73022,1.86556,2.31249");
	}
	fall_transition(template_1) {
          values("0.01540,0.01757,0.02337,0.03906,0.08871,0.26660,0.86709");
	}
      }
    }
  }

}
