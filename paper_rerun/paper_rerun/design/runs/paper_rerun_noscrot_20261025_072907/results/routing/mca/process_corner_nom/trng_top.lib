library (trng_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 1.80;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }

  cell ("trng_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0221;
    }
    pin("dbg_raw_bit") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("0.85357,0.85794,0.86923,0.89669,0.96974,1.19403,1.90456");
	}
	rise_transition(template_1) {
          values("0.02220,0.02550,0.03524,0.06461,0.16171,0.48308,1.50724");
	}
	cell_fall(template_1) {
          values("0.85145,0.85538,0.86550,0.88867,0.94292,1.09494,1.57409");
	}
	fall_transition(template_1) {
          values("0.02057,0.02322,0.03048,0.05007,0.10924,0.30693,0.95491");
	}
      }
    }
    pin("dbg_raw_valid") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("0.91520,0.91957,0.93085,0.95831,1.03137,1.25566,1.96617");
	}
	rise_transition(template_1) {
          values("0.02221,0.02550,0.03525,0.06460,0.16172,0.48309,1.50726");
	}
	cell_fall(template_1) {
          values("0.91196,0.91589,0.92601,0.94918,1.00342,1.15546,1.63465");
	}
	fall_transition(template_1) {
          values("0.02058,0.02323,0.03048,0.05006,0.10923,0.30692,0.95457");
	}
      }
    }
    pin("health_fail") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.19446,1.19981,1.21240,1.24217,1.32254,1.55538,2.24586");
	}
	rise_transition(template_1) {
          values("0.02027,0.02449,0.03641,0.07248,0.18502,0.52173,1.50720");
	}
	cell_fall(template_1) {
          values("1.25464,1.25938,1.26964,1.29073,1.33612,1.45228,1.78705");
	}
	fall_transition(template_1) {
          values("0.01778,0.02065,0.02792,0.04568,0.09385,0.24225,0.69655");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.67806");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.51999");
	}
      }
    }
    pin("tx") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("0.93117,0.93550,0.94674,0.97417,1.04723,1.27119,1.98068");
	}
	rise_transition(template_1) {
          values("0.02226,0.02555,0.03530,0.06463,0.16186,0.48267,1.50642");
	}
	cell_fall(template_1) {
          values("0.90986,0.91377,0.92387,0.94702,1.00119,1.15342,1.63323");
	}
	fall_transition(template_1) {
          values("0.02068,0.02331,0.03049,0.04994,0.10912,0.30677,0.94976");
	}
      }
    }
  }

}
